{
  "name": "brisca-backend",
  "version": "1.0.0",
  "description": "Brisca card game backend — game engine, AI, and Socket.io/Redis server",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "lint": "eslint .",
    "test": "c8 node --test"
  },
  "c8": {
    "all": true,
    "include": [
      "**/*.js"
    ],
    "exclude": [
      "test/**",
      "scripts/**",
      "coverage/**",
      "eslint.config.js"
    ],
    "reporter": [
      "text"
    ],
    "reporterOptions": {
      "text": {
        "maxCols": 0
      }
    }
  },
  "dependencies": {
    "redis": "^4.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "socket.io-client": "^4.8.1"
  },
  "overrides": {
    "ws": "^8.21.1"
  }
}
